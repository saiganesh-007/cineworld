# Frontend (Vite) — public values only
# Copy this file to .env.local and fill in your Supabase project values.
# Never put the service_role key in any VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# TMDB API key (public, used by the frontend at runtime)
VITE_TMDB_API_KEY=your-tmdb-api-key

# Supabase Dashboard → Authentication → URL Configuration
# Site URL (local): http://localhost:5174
# Redirect URLs:
#   http://localhost:5174/**
#   http://localhost:5174/auth/callback
#   http://localhost:5174/reset-password
#   http://localhost:5173/**
#   http://127.0.0.1:5174/**
#   http://127.0.0.1:5173/**

# After the production domain is assigned, add to Supabase:
#   Site URL: https://your-production-domain.com
#   Redirect URLs: https://your-production-domain.com/**

# Backend (Flask) — public values only
# Copy this file to backend/.env and fill in your Supabase project values.
# Use a publishable (anon) key, NEVER the service_role/secret key.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production database. REQUIRED on Vercel — the platform filesystem is
# ephemeral, so SQLite must not be used in production.
# Use a persistent PostgreSQL database (this is already supported).
# Local development may omit it; the backend falls back to
# backend/instance/cineworld.db.
DATABASE_URL=postgresql://user:password@host:5432/cineworld

# Optional comma-separated allowlist of CORS origins for production.
# Leave unset for local development (allows all origins). Since the
# frontend and /api share the same origin in production, CORS is
# usually not even needed there.
ALLOWED_ORIGINS=https://your-production-domain.com